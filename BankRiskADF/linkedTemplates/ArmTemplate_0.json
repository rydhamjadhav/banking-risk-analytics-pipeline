{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "BankRiskADF"
		},
		"BlobLinkService_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'BlobLinkService'"
		},
		"SQlLinkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQlLinkedService'"
		},
		"SQlLinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "bankriskserver.database.windows.net"
		},
		"SQlLinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "BankRiskDB"
		},
		"SQlLinkedService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "bankproject"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/BlobLinkService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Connection to raw clean loan data",
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('BlobLinkService_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/SQlLinkedService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "to connect sql database ",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('SQlLinkedService_properties_typeProperties_server')]",
					"database": "[parameters('SQlLinkedService_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('SQlLinkedService_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('SQlLinkedService_password')]"
					}
				}
			},
			"dependsOn": []
