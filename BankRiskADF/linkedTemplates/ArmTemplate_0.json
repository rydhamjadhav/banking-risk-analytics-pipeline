						"name": "interest_rate",
						"type": "String"
					},
					{
						"name": "credit_score",
						"type": "String"
					},
					{
						"name": "existing_loans",
						"type": "String"
					},
					{
						"name": "default_history",
						"type": "String"
					},
					{
						"name": "collateral_value",
						"type": "String"
					},
					{
						"name": "loan_purpose",
						"type": "String"
					},
					{
						"name": "loan_date",
						"type": "String"
					},
					{
						"name": "loan_status",
						"type": "String"
					},
					{
						"name": "Prop_16",
						"type": "String"
					},
					{
						"name": "debt_to_income_ratio",
						"type": "String"
					},
					{
						"name": "monthly_EMI",
						"type": "String"
					},
					{
						"name": "risk flag",
						"type": "String"
					}
				]
			},
