{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "BankRiskADF"
		},
		"BlobLinkService_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'BlobLinkService'"
		},
		"SQlLinkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQlLinkedService'"
		},
		"SQlLinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "bankriskserver.database.windows.net"
		},
		"SQlLinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "BankRiskDB"
		},
		"SQlLinkedService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "bankproject"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "BankRiskADF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"BlobLinkService_connectionString": {
						"value": "[parameters('BlobLinkService_connectionString')]"
					},
					"SQlLinkedService_password": {
						"value": "[parameters('SQlLinkedService_password')]"
					},
					"SQlLinkedService_properties_typeProperties_server": {
						"value": "[parameters('SQlLinkedService_properties_typeProperties_server')]"
					},
					"SQlLinkedService_properties_typeProperties_database": {
						"value": "[parameters('SQlLinkedService_properties_typeProperties_database')]"
					},
					"SQlLinkedService_properties_typeProperties_userName": {
						"value": "[parameters('SQlLinkedService_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}